# 4mula API - Environment Variables
# Copy this file to .env before starting the services

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payrollza

# Database Connection URL (Inside Docker Compose host is 'db', locally use 'localhost')
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/payrollza

# Environment (development, testing, production)
ENVIRONMENT=development
